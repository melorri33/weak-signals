# Скопируй в .env и заполни. .env не коммитим.
DATABASE_URL=postgresql+psycopg://weak:weak@localhost:5432/weak_signals

# Эти переменные читает docker-compose при создании базы — держим их согласованными с DATABASE_URL.
POSTGRES_USER=weak
POSTGRES_PASSWORD=weak
POSTGRES_DB=weak_signals
POSTGRES_PORT=5432

# ollama — модель на своей машине (нужна видеокарта), yandexgpt и gigachat — облако из списка ТЗ.
LLM_PROVIDER=ollama
# Для ollama: 8b нужен для качества расширения запроса, 4b на части областей выдаёт мусор (замеры в README).
# Для yandexgpt: yandexgpt-5-lite, yandexgpt-5-pro или yandexgpt-5.1 — только эти разрешает ТЗ.
# Для gigachat: GigaChat-2 (Lite), GigaChat-2-Pro или GigaChat-2-Max.
LLM_MODEL=qwen3:8b
OLLAMA_URL=http://localhost:11434
# Адрес Ollama для контейнеров: внутри контейнера localhost — это он сам, и приложение
# само берёт адрес отсюда, когда видит, что работает в контейнере.
# Ollama в контейнере (профиль local-llm) — http://ollama:11434.
OLLAMA_URL_IN_DOCKER=http://host.docker.internal:11434
# Ответы модели кэшируются в data/llm_cache: повторный прогон и демонстрация идут мгновенно.
LLM_CACHE=1

# Облако Яндекса: сервисный аккаунт с ролью ai.languageModels.user и каталог.
# Пустые — работает только локальный Ollama.
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_API_URL=https://ai.api.cloud.yandex.net/v1/chat/completions

# GigaChat (Сбер): «Authorization Key» из developers.sber.ru → проект GigaChat API → Настройки API.
# Серверы Сбера подписаны НУЦ Минцифры — нужен корневой сертификат файлом:
#   curl -o data/certs/russian_trusted_root_ca_pem.crt https://gu-st.ru/content/lending/russian_trusted_root_ca_pem.crt
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_CA_BUNDLE=data/certs/russian_trusted_root_ca_pem.crt

EMBED_MODEL=BAAI/bge-m3

CONTACT_EMAIL=
# Бесплатный ключ: аккаунт на openalex.org → $1 в день (без ключа $0.10). У каждого свой.
OPENALEX_API_KEY=
PATENTSVIEW_API_KEY=
LENS_API_TOKEN=

# Порты API и интерфейса на хосте.
API_PORT=8000
UI_PORT=8501
WEB_PORT=3000

MAX_DOCUMENTS=2000
SOURCE_TIMEOUT_S=15
COLLECT_BUDGET_S=60
CACHE_TTL_DAYS=7
